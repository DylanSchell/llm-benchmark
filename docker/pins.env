# External version pins for the runner image.
#
# This file is the single source of truth for everything the runner image pulls from outside
# this repository. `build.sh docker-build` sources it and passes each value as a --build-arg,
# so the Dockerfile's build args deliberately have no defaults: a bare `docker build` fails
# loudly rather than silently producing an unpinned image.
#
# Re-pin everything to the latest published versions with:
#     ./build.sh docker-repin
#
# Per docs/specs/runner-image.md, any change in this file is a runner-image change and must be
# accompanied by a version bump in Cargo.toml. `./build.sh docker-verify` enforces that.

# ---------------------------------------------------------------------------
# Base image, pinned by digest for reproducibility, so a rebuild cannot pick
# up a different JDK underneath us. The digest is that of the multi-arch
# manifest list, so it is correct for both linux/amd64 and linux/arm64.
# To check for a newer digest:
#     docker buildx imagetools inspect bellsoft/liberica-openjdk-debian:17 \
#       --format '{{.Manifest.Digest}}'
# ---------------------------------------------------------------------------
BASE_IMAGE=bellsoft/liberica-openjdk-debian:17@sha256:7862088e6a827a407e0c01803eef0c218e09999578bf1dbfb5db1b7323521b5a

# ---------------------------------------------------------------------------
# Language toolchains
# ---------------------------------------------------------------------------
GO_VERSION=1.21.13
FD_VERSION=10.4.2
NODE_MAJOR=20
RUST_VERSION=1.98.1
UV_VERSION=0.12.13

GRADLE_VERSION=8.7
# SHA-256 of the Gradle distribution zip; refresh alongside GRADLE_VERSION:
#   curl -fsSL "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip.sha256"
GRADLE_SHA256=544c35d6bd849ae8a5ed0bcea39ba677dc40f49df7d1835561582da2009b961d

# ---------------------------------------------------------------------------
# Agent CLIs — managed by docker/pin-agents.sh
#
# Pinned because the benchmark measures the agent; an unpinned rebuild would
# change the thing under test. Note that supi-bash-timeout is additionally a
# *contract* with the binary: crates/benchmark-core/src/agent/pi.rs hardcodes
# /usr/lib/node_modules plus paths inside those packages (src/extension.ts), so
# a bump that moves those files breaks the pi agent.
# ---------------------------------------------------------------------------
CLAUDE_CODE_VERSION=2.1.269

# pi comes from its official standalone (bun-compiled) binary release rather than npm.
# The npm package requires Node >=22.19.0, which would drag the image's Node version along
# with the agent; the standalone binary embeds the bun runtime and needs no Node at all, so
# the JS track's Node version stays independent of the agent under test.
#
# Both linux architectures are published. The Dockerfile picks between them using TARGETARCH.
# Asset checksums come from the release's SHA256SUMS file:
#   https://github.com/earendil-works/pi/releases/download/v<VERSION>/SHA256SUMS
# `docker/pin-agents.sh` refreshes these when it bumps the version, and the build verifies
# them, so a stale hash fails the build instead of shipping silently.
PI_CODING_AGENT_VERSION=1.0.2
PI_SHA256_X64=0d7687a6a9fcbaa88ff664cb6b28683ce9ee3e028931b55eb48a70ae9a285d18
PI_SHA256_ARM64=3321ccdc3ff38d6c52274bdab28246e06434618d1988a54e99cce45e535a013c

SUPI_BASH_TIMEOUT_VERSION=6.4.0

# ---------------------------------------------------------------------------
# JavaScript test dependencies (what the Exercism JS track expects).
#
# Note: jest is now pinned at 30.x while babel-jest and @types/jest remain at
# 29.x. That mix is pre-existing — `npm install -g jest` was unpinned and had
# already floated to 30.x — but it is now visible rather than implicit.
# ---------------------------------------------------------------------------
JEST_VERSION=30.5.1
BABEL_CORE_VERSION=7.25.2
BABEL_PRESET_ENV_VERSION=7.25.2
EXERCISM_BABEL_PRESET_VERSION=0.2.1
EXERCISM_ESLINT_CONFIG_VERSION=0.6.0
TYPES_JEST_VERSION=29.5.12
TYPES_NODE_VERSION=20.12.12
BABEL_JEST_VERSION=29.6.4
CORE_JS_VERSION=3.37.1
ESLINT_VERSION=8.49.0
