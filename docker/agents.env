# Which optional agent CLIs the runner image packages.
#
# This lives under docker/ on purpose: it is a build input, so flipping it changes
# docker_input_hash and ./build.sh docker-verify then demands a RUNNER_VERSION bump. Two images
# built from the same inputs are therefore guaranteed to contain the same agents, which a plain
# --build-arg could not promise.
#
# Claude Code is OFF by default. Anthropic licences it "all rights reserved" with no
# redistribution grant (see docker/README.md, Licensing), so an image containing it cannot be
# published to a registry. pi is MIT-licensed and ships in both variants.
#
#   INSTALL_CLAUDE=0   pi-only image — publishable
#   INSTALL_CLAUDE=1   full image — local use only, do not redistribute
INSTALL_CLAUDE=0
