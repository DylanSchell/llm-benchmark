# Base image for running the benchmark runner (Debian-based with glibc)
FROM bellsoft/liberica-openjdk-debian:17

# ARG for multi-arch builds
ARG TARGETARCH

# Install Go 1.21+ (needed for slices package used by newer Exercism exercises)
# Detect architecture for the correct Go binary
ARG TARGETARCH
RUN case "${TARGETARCH}" in \
      amd64) GO_ARCH=amd64 ;; \
      arm64) GO_ARCH=arm64 ;; \
      *)    GO_ARCH=amd64 ;; \
    esac && \
    curl -fsSL "https://go.dev/dl/go1.21.13.linux-${GO_ARCH}.tar.gz" -o /tmp/go.tar.gz \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz
ENV PATH="/usr/local/go/bin:$PATH"

# Install essential build tools (Go excluded — installed above)
RUN apt-get update && apt-get install -y \
    bash \
    fd-find \
    git \
    maven \
    python3 \
    python3-pip \
    clang \
    libclang-dev \
    make \
    g++ \
    curl \
    wget \
    libboost-dev \
    cmake \
    unzip \
    libboost-date-time-dev \
    fd-find \
    && ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/') \
    && if [ "$ARCH" = "arm64" ]; then FD_ARCH=aarch64; else FD_ARCH=x86_64; fi \
    && curl -fsSL "https://github.com/sharkdp/fd/releases/download/v10.4.2/fd-v10.4.2-${FD_ARCH}-unknown-linux-gnu.tar.gz" -o /tmp/fd.tar.gz \
    && tar -xzf /tmp/fd.tar.gz -C /tmp \
    && mv /tmp/fd-v10.4.2-${FD_ARCH}-unknown-linux-gnu/fd /usr/local/bin/fd \
    && chmod +x /usr/local/bin/fd \
    && rm -rf /tmp/fd.tar.gz /tmp/fd-v10.4.2-${FD_ARCH}-unknown-linux-gnu \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20.x from NodeSource
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Claude Code CLI
RUN npm install -g @anthropic-ai/claude-code
RUN npm install -g claude-plugins
#RUN npx claude-plugins install @anthropics/claude-code-plugins/ralph-wiggum
RUN npm install -g @mariozechner/pi-coding-agent@0.71.1
# Install pytest for Python testing
#RUN pip3 install --no-cache-dir pytest

# Install Jest and related packages for JavaScript testing
RUN npm install -g jest \
    @babel/core@7.25.2 \
    @babel/preset-env@7.25.2 \
    @exercism/babel-preset-javascript@0.2.1 \
    @exercism/eslint-config-javascript@0.6.0 \
    @types/jest@29.5.12 \
    @types/node@20.12.12 \
    babel-jest@29.6.4 \
    core-js@3.37.1 \
    eslint@8.49.0

# Create non-privileged user
RUN useradd -m -s /bin/bash -u 1000 runner && \
    chown -R runner:runner /home/runner

# Create workspace directory
RUN mkdir -p /workspace && chown runner:runner /workspace

# Set working directory
WORKDIR /workspace

# Switch to non-root user
USER runner

# Install rust toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/home/runner/.cargo/bin:$PATH"

# Install uv for Python package management
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/home/runner/.local/bin:$PATH"

# Install claude code transcript extraction tool
RUN uv tool install claude-code-transcripts
# Pre-install Gradle 8.7 so gradlew finds it pre-extracted at the hash location
# the wrapper expects. The wrapper computes a hash from the distribution URL;
# for the default https:// URL with this wrapper JAR, the hash is bhs2wmbdwecv87pi65oeuq5iu.
# We must also create a .ok marker file so the wrapper knows extraction succeeded.
ARG GRADLE_VERSION=8.7
ARG GRADLE_HASH=bhs2wmbdwecv87pi65oeuq5iu
ARG GRADLE_DIST_DIR=/home/runner/.gradle/wrapper/dists/gradle-${GRADLE_VERSION}-bin/${GRADLE_HASH}
RUN mkdir -p ${GRADLE_DIST_DIR} && \
    curl -fsSL "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" \
      -o /tmp/gradle-bin.zip && \
    unzip -q /tmp/gradle-bin.zip -d ${GRADLE_DIST_DIR} && \
    touch ${GRADLE_DIST_DIR}/gradle-${GRADLE_VERSION}-bin.zip.ok && \
    touch ${GRADLE_DIST_DIR}/gradle-${GRADLE_VERSION}-bin.zip.lck && \
    rm /tmp/gradle-bin.zip && \
    chown -R runner:runner /home/runner/.gradle

# Attempt to install pi extensions
#RUN pi install git:github.com/v2nic/pi-caveman

# Ensure gradle daemon is disabled (belt and suspenders: properties file + env var)
RUN mkdir -p /home/runner/.gradle && echo "org.gradle.daemon=false" >> /home/runner/.gradle/gradle.properties
ENV GRADLE_OPTS="-Dorg.gradle.daemon=false"
#COPY runner/.pi/agent/extensions/bash-timeout/index.ts /home/runner/.pi/agent/extensions/bash-timeout/index.ts

# Default command
CMD ["/bin/bash"]
