# Base image for running the benchmark runner (Debian-based with glibc)
FROM bellsoft/liberica-openjdk-debian:17

# Install essential build tools
RUN apt-get update && apt-get install -y \
    bash \
    fd-find \
    git \
    maven \
    python3 \
    python3-pip \
    golang-go \
    clang \
    libclang-dev \
    make \
    g++ \
    curl \
    wget \
    libboost-dev \
    cmake \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20.x from NodeSource
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Claude Code CLI
RUN npm install -g @anthropic-ai/claude-code
RUN npm install -g claude-plugins
#RUN npx claude-plugins install @anthropics/claude-code-plugins/ralph-wiggum
RUN npm install -g @mariozechner/pi-coding-agent
# Install pytest for Python testing
#RUN pip3 install --no-cache-dir pytest

# Install Jest and related packages for JavaScript testing
RUN npm install -g jest \
    @babel/core@7.25.2 \
    @babel/preset-env@7.25.2 \
    @exercism/babel-preset-javascript@0.2.1 \
    @exercism/eslint-config-javascript@0.6.0 \
    @types/jest@29.5.12 \
    @types/node@20.12.12 \
    babel-jest@29.6.4 \
    core-js@3.37.1 \
    eslint@8.49.0

# Create non-privileged user
RUN useradd -m -s /bin/bash -u 1000 runner && \
    chown -R runner:runner /home/runner

# Create workspace directory
RUN mkdir -p /workspace && chown runner:runner /workspace

# Set working directory
WORKDIR /workspace

# Switch to non-root user
USER runner

# Install rust toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/home/runner/.cargo/bin:$PATH"

# Install uv for Python package management
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/home/runner/.local/bin:$PATH"

# Install claude code transcript extraction tool
RUN uv tool install claude-code-transcripts
COPY gradle-8.7-bin.zip /opt/gradle/gradle-8.7-bin.zip

# Attempt to install pi extensions
#RUN pi install git:github.com/v2nic/pi-caveman

# Ensure gradle daemon is disabled
RUN mkdir -p /home/runner/.gradle && echo "org.gradle.daemon=false" >> /home/runner/.gradle/gradle.properties
#COPY runner/.pi/agent/extensions/bash-timeout/index.ts /home/runner/.pi/agent/extensions/bash-timeout/index.ts

# Default command
CMD ["/bin/bash"]
