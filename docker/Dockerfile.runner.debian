# Runner image: the language toolchains and agent CLIs used by exercise containers.
#
# Every external version this image pulls in is defined in docker/pins.env and passed as a
# build arg by ./build.sh docker-build. The ARGs below deliberately have no defaults, so a bare
# `docker build` fails loudly instead of silently producing an unpinned image.
#
# Changing this file is a runner-image change: bump the version in Cargo.toml.
# See docs/specs/runner-image.md and docker/README.md.

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Which runner-image version this is. Versioned independently of the Rust binary; see
# docs/specs/runner-image.md and ./build.sh docker-verify.
ARG RUNNER_VERSION
ARG AGENTS
LABEL org.opencontainers.image.title="llm-benchmark runner" \
      org.opencontainers.image.version="${RUNNER_VERSION}" \
      org.opencontainers.image.description="Language toolchains and agent CLIs for llm-benchmark exercise containers" \
      com.llm-benchmark.agents="${AGENTS}"

# Go 1.21+ is needed for the slices package used by newer Exercism exercises.
# TARGETARCH is supplied automatically by buildx.
ARG GO_VERSION
ARG TARGETARCH
RUN case "${TARGETARCH}" in \
      amd64) GO_ARCH=amd64 ;; \
      arm64) GO_ARCH=arm64 ;; \
      *)     echo "unsupported TARGETARCH for Go: ${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${GO_ARCH}.tar.gz" -o /tmp/go.tar.gz \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz
ENV PATH="/usr/local/go/bin:$PATH"

# Essential build tools (Go is installed above). fd also exists as the Debian `fd-find`
# package, but that ships the binary as `fdfind`, so the real `fd` comes from GitHub.
ARG FD_VERSION
RUN apt-get update && apt-get install -y \
    bash \
    fd-find \
    git \
    maven \
    python3 \
    python3-pip \
    clang \
    libclang-dev \
    make \
    g++ \
    curl \
    wget \
    libboost-dev \
    cmake \
    unzip \
    libboost-date-time-dev \
    && case "${TARGETARCH}" in \
         amd64) FD_ARCH=x86_64 ;; \
         arm64) FD_ARCH=aarch64 ;; \
         *)     echo "unsupported TARGETARCH for fd: ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && curl -fsSL "https://github.com/sharkdp/fd/releases/download/v${FD_VERSION}/fd-v${FD_VERSION}-${FD_ARCH}-unknown-linux-gnu.tar.gz" -o /tmp/fd.tar.gz \
    && tar -xzf /tmp/fd.tar.gz -C /tmp \
    && mv "/tmp/fd-v${FD_VERSION}-${FD_ARCH}-unknown-linux-gnu/fd" /usr/local/bin/fd \
    && chmod +x /usr/local/bin/fd \
    && rm -rf /tmp/fd.tar.gz "/tmp/fd-v${FD_VERSION}-${FD_ARCH}-unknown-linux-gnu" \
    && rm -rf /var/lib/apt/lists/*

# Node.js from NodeSource.
ARG NODE_MAJOR
RUN curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Agent CLIs — what the benchmark actually measures, so they are pinned.
#
# Claude Code is optional and excluded by default: Anthropic licences it "all rights reserved"
# with no redistribution grant, so an image containing it cannot be published (docker/README.md,
# Licensing). The switch is docker/agents.env, which is a hashed build input.
ARG CLAUDE_CODE_VERSION
ARG INSTALL_CLAUDE
RUN set -eux; \
    case "${INSTALL_CLAUDE}" in \
      0) echo "Not packaging Claude Code (INSTALL_CLAUDE=0)" ;; \
      1) npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"; \
         claude --version ;; \
      *) echo "INSTALL_CLAUDE must be 0 or 1, got '${INSTALL_CLAUDE}'" >&2; exit 1 ;; \
    esac

# pi is installed from its official standalone (bun-compiled) binary rather than from npm, so
# that pi's runtime requirements stop dictating the image's Node version: the npm package needs
# Node >=22.19.0, while the JS track pins Node 20. The binary embeds the bun runtime and runs
# with no Node present at all.
#
# The tarball vendors photon_rs_bg.wasm, assets/, theme/, export-html/ and node_modules/ next to
# the executable, so -C /opt/pi --strip-components=1 keeps that layout intact. Flattening the
# archive into /usr/local/bin breaks asset resolution; putting /opt/pi on PATH works instead.
# Both linux architectures are published, selected here with buildx's TARGETARCH.
ARG PI_CODING_AGENT_VERSION
ARG PI_SHA256_X64
ARG PI_SHA256_ARM64
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) PI_ARCH=x64;   PI_SHA256="${PI_SHA256_X64}" ;; \
      arm64) PI_ARCH=arm64; PI_SHA256="${PI_SHA256_ARM64}" ;; \
      *)     echo "unsupported TARGETARCH for pi: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    wget -q -O /tmp/pi.tar.gz \
      "https://github.com/earendil-works/pi/releases/download/v${PI_CODING_AGENT_VERSION}/pi-linux-${PI_ARCH}.tar.gz"; \
    echo "${PI_SHA256}  /tmp/pi.tar.gz" | sha256sum -c -; \
    mkdir -p /opt/pi; \
    tar -xzf /tmp/pi.tar.gz -C /opt/pi --strip-components=1; \
    chmod +x /opt/pi/pi; \
    rm /tmp/pi.tar.gz; \
    PI_SKIP_VERSION_CHECK=1 /opt/pi/pi --version
ENV PATH="/opt/pi:$PATH"

# pi extensions, loaded by the binary via --extension flags. crates/benchmark-core/src/agent/pi.rs
# hardcodes /usr/lib/node_modules (Debian's npm global root) and paths inside these packages
# (extensions/caveman.ts, src/extension.ts), so the npm root and their internal layout are part
# of the binary-image contract. They stay npm-installed: they are plain TypeScript packages, and
# Node is present for the JS track regardless.
ARG PI_CAVEMAN_VERSION
ARG SUPI_BASH_TIMEOUT_VERSION
RUN npm install -g \
    "pi-caveman@${PI_CAVEMAN_VERSION}" \
    "@mrclrchtr/supi-bash-timeout@${SUPI_BASH_TIMEOUT_VERSION}"

# Install pytest for Python testing
#RUN pip3 install --no-cache-dir pytest

# JavaScript test dependencies expected by the Exercism JS track.
ARG JEST_VERSION
ARG BABEL_CORE_VERSION
ARG BABEL_PRESET_ENV_VERSION
ARG EXERCISM_BABEL_PRESET_VERSION
ARG EXERCISM_ESLINT_CONFIG_VERSION
ARG TYPES_JEST_VERSION
ARG TYPES_NODE_VERSION
ARG BABEL_JEST_VERSION
ARG CORE_JS_VERSION
ARG ESLINT_VERSION
RUN npm install -g \
    "jest@${JEST_VERSION}" \
    "@babel/core@${BABEL_CORE_VERSION}" \
    "@babel/preset-env@${BABEL_PRESET_ENV_VERSION}" \
    "@exercism/babel-preset-javascript@${EXERCISM_BABEL_PRESET_VERSION}" \
    "@exercism/eslint-config-javascript@${EXERCISM_ESLINT_CONFIG_VERSION}" \
    "@types/jest@${TYPES_JEST_VERSION}" \
    "@types/node@${TYPES_NODE_VERSION}" \
    "babel-jest@${BABEL_JEST_VERSION}" \
    "core-js@${CORE_JS_VERSION}" \
    "eslint@${ESLINT_VERSION}"

# Create non-privileged user
RUN useradd -m -s /bin/bash -u 1000 runner && \
    chown -R runner:runner /home/runner

# Create workspace directory
RUN mkdir -p /workspace && chown runner:runner /workspace

# Record the version and the packaged agents inside the image too, so a running container can
# be identified without inspecting labels, and a binary/image mismatch is detectable at runtime.
RUN mkdir -p /etc/llm-benchmark \
    && printf '%s\n' "${RUNNER_VERSION}" > /etc/llm-benchmark/runner-version \
    && printf '%s\n' "${AGENTS}" > /etc/llm-benchmark/agents

# Set working directory
WORKDIR /workspace

# Switch to non-root user
USER runner

# Rust toolchain, pinned.
ARG RUST_VERSION
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain "${RUST_VERSION}"
ENV PATH="/home/runner/.cargo/bin:$PATH"

# uv for Python package management, pinned.
ARG UV_VERSION
RUN curl -LsSf "https://astral.sh/uv/${UV_VERSION}/install.sh" | sh
ENV PATH="/home/runner/.local/bin:$PATH"

# Pre-install Gradle so the wrapper finds it already extracted at the cache location it
# computes. Gradle names that directory base36(md5(distributionUrl)), so we derive it with
# docker/gradle-dist-hash.py rather than hardcoding a value that would silently go stale if
# the Exercism Java track bumps its wrapper (which would make gradlew download at test time).
# The .ok marker tells the wrapper the extraction completed.
ARG GRADLE_VERSION
ARG GRADLE_SHA256
COPY gradle-dist-hash.py /usr/local/lib/llm-benchmark/gradle-dist-hash.py
RUN set -eux; \
    dist_url="https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"; \
    hash="$(python3 /usr/local/lib/llm-benchmark/gradle-dist-hash.py "${dist_url}")"; \
    dist_dir="/home/runner/.gradle/wrapper/dists/gradle-${GRADLE_VERSION}-bin/${hash}"; \
    mkdir -p "${dist_dir}"; \
    curl -fsSL "${dist_url}" -o /tmp/gradle-bin.zip; \
    echo "${GRADLE_SHA256}  /tmp/gradle-bin.zip" | sha256sum -c -; \
    unzip -q /tmp/gradle-bin.zip -d "${dist_dir}"; \
    touch "${dist_dir}/gradle-${GRADLE_VERSION}-bin.zip.ok"; \
    rm /tmp/gradle-bin.zip; \
    chown -R runner:runner /home/runner/.gradle

# Ensure gradle daemon is disabled (belt and suspenders: properties file + env var)
RUN mkdir -p /home/runner/.gradle && echo "org.gradle.daemon=false" >> /home/runner/.gradle/gradle.properties
ENV GRADLE_OPTS="-Dorg.gradle.daemon=false"

# Default command
CMD ["/bin/bash"]
