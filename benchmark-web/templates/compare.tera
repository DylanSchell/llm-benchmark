{% extends "layout.tera" %}

{% block title %}Compare Models - Claude Benchmark{% endblock %}

{% block content %}
<div class="container">
    <h2 style="margin-bottom: 1.5rem;">Compare Models</h2>

    <!-- Selectors -->
    <div class="card" style="margin-bottom: 1rem;">
        <form method="get" action="/compare" style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-end;">
            <div class="form-group" style="margin-bottom: 0; min-width: 250px;">
                <label for="select-a">Run A</label>
                <select id="select-a" name="a">
                    <option value="">-- Select Model --</option>
                    {% for m in models %}
                    <option value="{{ m }}" {% if a == m %}selected{% endif %}>{{ m }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 0; min-width: 250px;">
                <label for="select-b">Run B</label>
                <select id="select-b" name="b">
                    <option value="">-- Select Model --</option>
                    {% for m in models %}
                    <option value="{{ m }}" {% if b == m %}selected{% endif %}>{{ m }}</option>
                    {% endfor %}
                </select>
            </div>

            {% if a != "" and b != "" %}
            <div class="form-group" style="margin-bottom: 0; min-width: 200px;">
                <label for="select-metric">Compare by</label>
                <select id="select-metric" name="metric" onchange="this.form.submit()">
                    <option value="speed" {% if metric == "speed" %}selected{% endif %}>Speed (Duration)</option>
                    <option value="tokens" {% if metric == "tokens" %}selected{% endif %}>Tokens</option>
                    <option value="turns" {% if metric == "turns" %}selected{% endif %}>Turns</option>
                    <option value="toolcalls" {% if metric == "toolcalls" %}selected{% endif %}>Tool Calls</option>
                </select>
            </div>
            {% endif %}

            <button type="submit" class="btn btn-primary">Compare</button>
            {% if a != "" and b != "" %}
            <button type="button" class="btn btn-secondary" onclick="swapRuns()">Swap</button>
            {% endif %}
        </form>
    </div>

    {% if a != "" and b != "" %}
    <!-- Summary Stats -->
    <div class="card" style="margin-bottom: 1rem;">
        <h3 style="margin-bottom: 1rem;">Summary: {{ a }} vs {{ b }} &mdash; {{ metric_label }}</h3>
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-value">{{ row_count }}</div>
                <div class="stat-label">Exercises Compared</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">{{ a_faster_count }}</div>
                <div class="stat-label">{{ a_label | default(value=a) }} better</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">{{ b_faster_count }}</div>
                <div class="stat-label">{{ b_label | default(value=b) }} better</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">{{ tie_count }}</div>
                <div class="stat-label">Ties / Missing</div>
            </div>
        </div>
    </div>

    <!-- Comparison Table -->
    <div class="card">
        <h3 style="margin-bottom: 1rem;">Exercise-by-Exercise Comparison</h3>
        <style>
            .compare-table { width: 100%; border-collapse: collapse; }
            .compare-table th { text-align: left; padding: 0.5rem; background: #f5f5f5; border-bottom: 2px solid #ddd; cursor: pointer; user-select: none; }
            .compare-table th:hover { background: #e8e8e8; }
            .compare-table td { padding: 0.5rem; border-bottom: 1px solid #eee; }
            .faster-a { background: #d4edda; }
            .faster-b { background: #f8d7da; }
            .tie-row { background: #fff3cd; }
            .only-a { background: #d4edda; }
            .only-b { background: #f8d7da; }
            .metric-cell { font-family: 'Consolas', 'Monaco', monospace; white-space: nowrap; }
            .ratio-cell { font-family: 'Consolas', 'Monaco', monospace; }
            .winner-badge { display: inline-block; padding: 0.1rem 0.4rem; border-radius: 3px; font-size: 0.7rem; font-weight: bold; margin-left: 0.3rem; }
            .winner-a-badge { background: #27ae60; color: white; }
            .winner-b-badge { background: #e74c3c; color: white; }
            .winner-tie-badge { background: #f39c12; color: white; }
        </style>
        <table class="compare-table" id="compare-table">
            <thead>
                <tr>
                    <th onclick="sortCompareTable(0)">Language &#x2195;</th>
                    <th onclick="sortCompareTable(1)">Exercise &#x2195;</th>
                    <th onclick="sortCompareTable(2, true)" style="text-align: right;">
                        {{ a_label | default(value=a) }}<br><span style="font-weight: normal; font-size: 0.8rem;">{{ metric_label }}</span> &#x2195;
                    </th>
                    <th onclick="sortCompareTable(3, true)" style="text-align: right;">
                        {{ b_label | default(value=b) }}<br><span style="font-weight: normal; font-size: 0.8rem;">{{ metric_label }}</span> &#x2195;
                    </th>
                    <th onclick="sortCompareTable(4, true)" style="text-align: right;">Ratio (A/B) &#x2195;</th>
                    <th style="text-align: right;">Winner</th>
                </tr>
            </thead>
            <tbody>
            {% for row in rows %}
                {% if row.sort_a and row.sort_b and row.sort_a > 0 and row.sort_b > 0 %}
                    {% if row.faster == "b" %}
                        <tr class="faster-b">
                    {% elif row.faster == "tie" %}
                        <tr class="tie-row">
                    {% else %}
                        <tr class="faster-a">
                    {% endif %}
                {% elif row.sort_a > 0 %}
                    <tr class="only-a">
                {% elif row.sort_b > 0 %}
                    <tr class="only-b">
                {% else %}
                    <tr>
                {% endif %}
                    <td>{{ row.language }}</td>
                    <td>{{ row.exercise }}</td>
                    <td class="metric-cell" style="text-align: right;" data-sort="{{ row.sort_a | default(value=0) }}">
                        {% if row.a_display %}
                            {{ row.a_display }}
                            {% if row.a_success %}
                                <span style="color: #27ae60;">&#x2713;</span>
                            {% else %}
                                <span style="color: #e74c3c;">&#x2717;</span>
                            {% endif %}
                            {% if metric == "speed" and row.a_tps %}<span style="color: #7f8c8d; font-size: 0.8rem;"> ({{ row.tps_a_fmt }})</span>{% endif %}
                        {% else %}
                            <span style="color: #ccc;">-</span>
                        {% endif %}
                    </td>
                    <td class="metric-cell" style="text-align: right;" data-sort="{{ row.sort_b | default(value=0) }}">
                        {% if row.b_display %}
                            {{ row.b_display }}
                            {% if row.b_success %}
                                <span style="color: #27ae60;">&#x2713;</span>
                            {% else %}
                                <span style="color: #e74c3c;">&#x2717;</span>
                            {% endif %}
                            {% if metric == "speed" and row.b_tps %}<span style="color: #7f8c8d; font-size: 0.8rem;"> ({{ row.tps_b_fmt }})</span>{% endif %}
                        {% else %}
                            <span style="color: #ccc;">-</span>
                        {% endif %}
                    </td>
                    <td class="ratio-cell" style="text-align: right;" data-sort="{{ row.sort_ratio | default(value=999) }}">
                        {% if row.ratio_fmt %}
                            {% if row.ratio_favor == "a" %}
                                <span style="color: #27ae60;">{{ row.ratio_fmt }}</span>
                            {% elif row.ratio_favor == "b" %}
                                <span style="color: #e74c3c;">{{ row.ratio_fmt }}</span>
                            {% else %}
                                <span style="color: #f39c12;">{{ row.ratio_fmt }}</span>
                            {% endif %}
                        {% else %}
                            <span style="color: #ccc;">-</span>
                        {% endif %}
                    </td>
                    <td style="text-align: right;">
                        {% if row.faster == "a" %}
                            <span class="winner-badge winner-a-badge">{{ a_label | default(value=a) }}</span>
                        {% elif row.faster == "b" %}
                            <span class="winner-badge winner-b-badge">{{ b_label | default(value=b) }}</span>
                        {% elif row.sort_a > 0 and row.sort_b > 0 %}
                            <span class="winner-badge winner-tie-badge">tie</span>
                        {% elif row.sort_a > 0 %}
                            <span class="winner-badge winner-a-badge">only A</span>
                        {% elif row.sort_b > 0 %}
                            <span class="winner-badge winner-b-badge">only B</span>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            {% if rows | length == 0 %}
                <tr>
                    <td colspan="6" style="text-align: center; color: #7f8c8d; padding: 2rem;">No comparison data available. These models may have no overlapping exercises.</td>
                </tr>
            {% endif %}
            </tbody>
        </table>
    </div>
    {% else %}
    <div class="card">
        <p style="text-align: center; color: #7f8c8d; padding: 2rem;">Select two models above and click Compare to see side-by-side exercise execution times.</p>
    </div>
    {% endif %}
</div>

<script>
    // Swap the two selections
    function swapRuns() {
        const a = document.getElementById('select-a');
        const b = document.getElementById('select-b');
        const tmp = a.value;
        a.value = b.value;
        b.value = tmp;
        document.querySelector('form').submit();
    }

    // Table sorting
    let sortDir = {};

    function sortCompareTable(colIdx, isNumeric) {
        const table = document.getElementById('compare-table');
        const tbody = table.querySelector('tbody');
        const rows = Array.from(tbody.querySelectorAll('tr'));

        if (!sortDir[colIdx]) sortDir[colIdx] = false;
        sortDir[colIdx] = !sortDir[colIdx];
        const asc = sortDir[colIdx];

        rows.sort((a, b) => {
            if (a.children.length < 6 || b.children.length < 6) return 0;
            const aCell = a.children[colIdx];
            const bCell = b.children[colIdx];

            let aVal, bVal;
            if (isNumeric) {
                aVal = parseFloat(aCell.getAttribute('data-sort') || '0');
                bVal = parseFloat(bCell.getAttribute('data-sort') || '0');
            } else {
                aVal = (aCell.textContent || '').trim().toLowerCase();
                bVal = (bCell.textContent || '').trim().toLowerCase();
            }

            if (aVal < bVal) return asc ? -1 : 1;
            if (aVal > bVal) return asc ? 1 : -1;
            return 0;
        });

        rows.forEach(r => tbody.appendChild(r));
    }
</script>
{% endblock %}
