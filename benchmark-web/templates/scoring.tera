{% extends "layout.tera" %}

{% block title %}Scoring Dashboard - Benchmark Results{% endblock %}

{% block content %}
<div class="container">
    <h2 style="margin-bottom: 1.5rem;">Scoring Dashboard</h2>

    <!-- Scoring Methodology Info -->
    <div class="card" style="margin-bottom: 1.5rem; background: #e8f4f8; border-left: 4px solid #3498db;">
        <h3 style="margin-bottom: 0.75rem; color: #2c3e50;">Scoring Methodology</h3>
        <p style="margin-bottom: 0.5rem; color: #555;">
            Results are scored using a weighted composite metric that balances three dimensions:
        </p>
        <ul style="margin-left: 1.5rem; color: #555;">
            <li><strong>Correctness (70%)</strong> - Percentage of exercises completed successfully</li>
            <li><strong>Speed (20%)</strong> - How fast the agent completes exercises (faster = better)</li>
            <li><strong>Token Efficiency (10%)</strong> - How efficiently tokens are used (fewer = better, power-law scaling)</li>
        </ul>
        <p style="margin-top: 0.75rem; font-size: 0.875rem; color: #7f8c8d;">
            <em>Note: Only successful runs contribute to speed and token scores. If success rate is 0%, the composite score is also 0%. Missing exercises are counted as failures in the correctness score.</em>
        </p>
    </div>

    <!-- Filters -->
    <div class="card" style="margin-bottom: 1.5rem;">
        <form id="scoring-filter-form" method="get" action="/scoring" style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-end;">
            <div class="form-group" style="margin-bottom: 0; min-width: 200px;">
                <label for="filter-language">Language</label>
                <select id="filter-language" name="language">
                    <option value="">All Languages</option>
                    <option value="java" {% if filter_language == "java" %}selected{% endif %}>Java</option>
                    <option value="go" {% if filter_language == "go" %}selected{% endif %}>Go</option>
                    <option value="javascript" {% if filter_language == "javascript" %}selected{% endif %}>JavaScript</option>
                    <option value="python" {% if filter_language == "python" %}selected{% endif %}>Python</option>
                    <option value="rust" {% if filter_language == "rust" %}selected{% endif %}>Rust</option>
                    <option value="cpp" {% if filter_language == "cpp" %}selected{% endif %}>C++</option>
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 0; min-width: 200px;">
                <label for="filter-agent">Agent</label>
                <select id="filter-agent" name="agent">
                    <option value="">All Agents</option>
                    <option value="reference" {% if filter_agent == "reference" %}selected{% endif %}>Reference</option>
                    <option value="claude" {% if filter_agent == "claude" %}selected{% endif %}>Claude</option>
                    <option value="pi" {% if filter_agent == "pi" %}selected{% endif %}>Pi</option>
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 0; display: flex; align-items: center;">
                <label style="display: flex; align-items: center; cursor: pointer; margin-top: 1.5rem;">
                    <input type="checkbox" name="quick" value="true"
                           {% if filter_quick %}checked{% endif %}
                           style="margin-right: 0.5rem; width: auto;">
                    <span>Quick bench only</span>
                </label>
            </div>

            <button type="submit" class="btn btn-primary">Filter</button>
            <a href="/scoring" class="btn">Clear</a>
        </form>
        <script>
            document.getElementById('scoring-filter-form').addEventListener('submit', function(e) {
                e.preventDefault();
                var params = new URLSearchParams();
                var language = this.querySelector('[name="language"]').value;
                var agent = this.querySelector('[name="agent"]').value;
                var quick = this.querySelector('[name="quick"]').checked;
                
                if (language) params.set('language', language);
                if (agent) params.set('agent', agent);
                if (quick) params.set('quick', 'true');
                
                window.location.search = params.toString();
            });
        </script>
    </div>

    <!-- Model Rankings -->
    <div class="card" style="margin-bottom: 1.5rem;">
        <h3 style="margin-bottom: 1rem;">Model Rankings (by Average Composite Score)</h3>
        <style>
            .rank-table { width: 100%; border-collapse: collapse; }
            .rank-table th { text-align: left; padding: 0.75rem; background: #f5f5f5; border-bottom: 2px solid #ddd; font-weight: bold; }
            .rank-table td { padding: 0.75rem; border-bottom: 1px solid #eee; }
            .rank-table tr:hover { background: #f9f9f9; }
            .rank-position { font-size: 1.25rem; font-weight: bold; color: #3498db; text-align: center; }
            .score-bar { height: 8px; background: #ecf0f1; border-radius: 4px; overflow: hidden; margin-top: 0.25rem; }
            .score-fill { height: 100%; border-radius: 4px; transition: width 0.3s ease; }
            .score-fill.composite { background: linear-gradient(90deg, #3498db, #2ecc71); }
            .score-fill.success { background: #27ae60; }
            .score-fill.speed { background: #3498db; }
            .score-fill.tokens { background: #9b59b6; }
        </style>
        <table class="rank-table">
            <thead>
                <tr>
                    <th style="width: 50px;">Rank</th>
                    <th>Model</th>
                    <th style="width: 120px;">Composite Score</th>
                    <th style="width: 120px;">Success Rate</th>
                    <th style="width: 120px;">Speed Score</th>
                    <th style="width: 120px;">Token Score</th>
                    <th style="width: 120px;">Total Tokens</th>
                    <th style="width: 120px;">Total Chars</th>
                    <th style="width: 80px;">Runs</th>
                </tr>
            </thead>
            <tbody>
            {% for model in model_scores %}
                <tr>
                    <td class="rank-position">{{ loop.index }}</td>
                    <td style="font-weight: 500;">{{ model.name }}</td>
                    <td>
                        <div style="font-weight: bold; color: #2c3e50;">
                            {{ (model.avg_composite_score * 1000 | round / 10) }}%
                        </div>
                        <div class="score-bar">
                            <div class="score-fill composite" style="width: {{ (model.avg_composite_score * 100) | default(value=0) }}%;"></div>
                        </div>
                    </td>
                    <td>
                        <div>{{ (model.avg_success_rate * 1000 | round / 10) }}%</div>
                        <div class="score-bar">
                            <div class="score-fill success" style="width: {{ (model.avg_success_rate * 100) | default(value=0) }}%;"></div>
                        </div>
                    </td>
                    <td>
                        <div>{{ (model.avg_speed_score * 1000 | round / 10) }}%</div>
                        <div class="score-bar">
                            <div class="score-fill speed" style="width: {{ (model.avg_speed_score * 100) | default(value=0) }}%;"></div>
                        </div>
                    </td>
                    <td>
                        <div>{{ (model.avg_token_score * 1000 | round / 10) }}%</div>
                        <div class="score-bar">
                            <div class="score-fill tokens" style="width: {{ (model.avg_token_score * 100) | default(value=0) }}%;"></div>
                        </div>
                    </td>
                    <td style="text-align: right;">{{ model.total_tokens | format_number }}</td>
                    <td style="text-align: right;">{{ model.total_chars | default(value=0) | format_number }}</td>
                    <td style="text-align: center; color: #7f8c8d;">{{ model.total_runs }}</td>
                </tr>
            {% endfor %}
            {% if model_scores | length == 0 %}
                <tr>
                    <td colspan="8" style="text-align: center; color: #7f8c8d; padding: 2rem;">
                        No scoring data available. Try adjusting your filters or run some benchmarks first.
                    </td>
                </tr>
            {% endif %}
            </tbody>
        </table>
    </div>

    <!-- Individual Results -->
    <div class="card">
        <h3 style="margin-bottom: 1rem;">Individual Exercise Results (Sorted by Composite Score)</h3>
        <p style="color: #7f8c8d; margin-bottom: 1rem;">
            Showing {{ total_results }} result(s)
            {% if filter_language %}for language "{{ filter_language }}"{% endif %}
            {% if filter_agent %}by agent "{{ filter_agent }}"{% endif %}
            {% if filter_quick %}(quick bench only){% endif %}
        </p>
        <style>
            .score-table { width: 100%; border-collapse: collapse; }
            .score-table th { text-align: left; padding: 0.75rem; background: #f5f5f5; border-bottom: 2px solid #ddd; font-weight: bold; cursor: pointer; }
            .score-table td { padding: 0.75rem; border-bottom: 1px solid #eee; }
            .score-table tr:hover { background: #f9f9f9; }
            .success-badge { display: inline-block; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: bold; }
            .success-badge.success { background: #27ae60; color: white; }
            .success-badge.failed { background: #e74c3c; color: white; }
            .score-cell { font-weight: bold; }
        </style>
        <table class="score-table sortable-table">
            <thead>
                <tr>
                    <th onclick="sortScoreTable(this, 'composite')" style="cursor: pointer;">Composite Score ↕</th>
                    <th onclick="sortScoreTable(this, 'success')" style="cursor: pointer;">Success Rate ↕</th>
                    <th onclick="sortScoreTable(this, 'speed')" style="cursor: pointer;">Speed Score ↕</th>
                    <th onclick="sortScoreTable(this, 'tokens')" style="cursor: pointer;">Token Score ↕</th>
                    <th onclick="sortScoreTable(this, 'agent')" style="cursor: pointer;">Agent ↕</th>
                    <th onclick="sortScoreTable(this, 'model')" style="cursor: pointer;">Model ↕</th>
                    <th onclick="sortScoreTable(this, 'language')" style="cursor: pointer;">Language ↕</th>
                    <th onclick="sortScoreTable(this, 'exercise')" style="cursor: pointer;">Exercise ↕</th>
                    <th onclick="sortScoreTable(this, 'duration')" style="cursor: pointer;">Duration ↕</th>
                    <th onclick="sortScoreTable(this, 'tokens')" style="cursor: pointer;">Tokens ↕</th>
                    <th onclick="sortScoreTable(this, 'chars')" style="cursor: pointer;">Chars ↕</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="score-body">
            {% for result in results %}
                <tr>
                    <td class="score-cell" data-sort="{{ result.composite_score }}">
                        {{ (result.composite_score * 1000 | round / 10) }}%
                    </td>
                    <td data-sort="{{ result.success_rate }}">
                        {% if result.success %}
                            <span class="success-badge success">{{ (result.success_rate * 1000 | round / 10) }}%</span>
                        {% else %}
                            <span class="success-badge failed">Failed</span>
                        {% endif %}
                    </td>
                    <td data-sort="{{ result.speed_score }}">
                        {{ (result.speed_score * 1000 | round / 10) }}%
                    </td>
                    <td data-sort="{{ result.token_score }}">
                        {{ (result.token_score * 1000 | round / 10) }}%
                    </td>
                    <td>{{ result.agent }}</td>
                    <td>
                        <a href="/results?model={{ result.model }}" style="color: #3498db;">{{ result.model }}</a>
                    </td>
                    <td>{{ result.language }}</td>
                    <td>{{ result.exercise }}</td>
                    <td>{{ result.duration | default(value="-") }}</td>
                    <td data-sort="{{ result.output_tokens }}">
                        {{ result.output_tokens | format_number }}
                        {% if result.tokens_per_sec %}
                            <br><span style="font-size: 0.75rem; color: #7f8c8d;">
                                {{ (result.tokens_per_sec * 10 | round / 10) }} t/s
                            </span>
                        {% endif %}
                    </td>
                    <td data-sort="{{ result.output_chars }}" title="Input / Output chars">
                        {{ result.input_chars | default(value=0) | format_number }} /
                        {{ result.output_chars | default(value=0) | format_number }}
                    </td>
                    <td>
                        <a href="{{ result.detail_url }}" class="btn btn-primary" style="font-size: 0.8rem; padding: 0.25rem 0.5rem;">Details</a>
                    </td>
                </tr>
            {% endfor %}
            {% if results | length == 0 %}
                <tr>
                    <td colspan="11" style="text-align: center; color: #7f8c8d; padding: 2rem;">
                        No results found. Try adjusting your filters or run some benchmarks first.
                    </td>
                </tr>
            {% endif %}
            </tbody>
        </table>
    </div>

    <script>
        // Table sorting for scoring page
        let scoreSortDirections = {};

        function sortScoreTable(thEl, column) {
            const columnIdx = thEl.cellIndex;
            const table = thEl.closest('table');
            if (!table) return;

            const tbody = table.querySelector('tbody');
            if (!tbody) return;

            const rows = Array.from(tbody.querySelectorAll('tr'));
            if (rows.length === 0) return;

            const key = column;

            if (!scoreSortDirections[key]) {
                scoreSortDirections[key] = false;
            }
            scoreSortDirections[key] = !scoreSortDirections[key];
            const ascending = scoreSortDirections[key];

            rows.sort((a, b) => {
                if (a.children.length === 0 || b.children.length === 0) return 0;

                let aVal, bVal;
                const aCell = a.children[columnIdx];
                const bCell = b.children[columnIdx];

                // Try to get data-sort attribute first
                const aSort = aCell.getAttribute('data-sort');
                const bSort = bCell.getAttribute('data-sort');

                if (aSort !== null && bSort !== null) {
                    aVal = parseFloat(aSort);
                    bVal = parseFloat(bSort);
                } else {
                    // Fallback to text content
                    aVal = aCell.textContent.trim().toLowerCase();
                    bVal = bCell.textContent.trim().toLowerCase();
                }

                if (typeof aVal === 'number' && typeof bVal === 'number') {
                    if (aVal < bVal) return ascending ? -1 : 1;
                    if (aVal > bVal) return ascending ? 1 : -1;
                } else {
                    if (aVal < bVal) return ascending ? -1 : 1;
                    if (aVal > bVal) return ascending ? 1 : -1;
                }
                return 0;
            });

            rows.forEach(row => tbody.appendChild(row));
        }
    </script>
</div>
{% endblock %}
