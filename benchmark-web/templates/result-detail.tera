{% extends "layout.tera" %}

{% block title %}{{ agent }} - {{ exercise }} - Benchmark Results{% endblock %}

{% block content %}
<div class="container">
    <nav style="margin-bottom: 1.5rem; font-size: 0.875rem; color: #7f8c8d;">
        <a href="/results" style="color: #3498db; text-decoration: none;">Results</a>
        {% if agent %} &gt; <a href="/results?agent={{ agent }}" style="color: #3498db; text-decoration: none;">{{ agent }}</a>{% endif %}
        {% if model %} &gt; <a href="/results?model={{ model }}" style="color: #3498db; text-decoration: none;">{{ model }}</a>{% endif %}
        {% if language %} &gt; <a href="/results?language={{ language }}" style="color: #3498db; text-decoration: none;">{{ language }}</a>{% endif %}
        &gt; <span>{{ exercise }}</span>
    </nav>

    <div class="card">
        <h2 style="margin-bottom: 1rem;">{{ agent }} - {{ exercise }}</h2>
        
        <!-- Summary Cards -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
            <div class="stat-card">
                <div class="stat-value" style="font-size: 1.5rem;">
                    {% if success %}✓{% else %}✗{% endif %}
                </div>
                <div class="stat-label">Status</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" style="font-size: 1.5rem;">{{ language }}</div>
                <div class="stat-label">Language</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" style="font-size: 1.5rem;">{{ duration | default(value="-") }}</div>
                <div class="stat-label">Duration</div>
            </div>
        </div>

        <!-- Details -->
        <div style="margin-bottom: 1.5rem;">
            <h3 style="margin-bottom: 0.75rem;">Details</h3>
            <table style="width: 100%; border-collapse: collapse;">
                <tbody>
                    <tr>
                        <td style="padding: 0.5rem; border-bottom: 1px solid #eee; width: 200px;"><strong>Agent:</strong></td>
                        <td style="padding: 0.5rem; border-bottom: 1px solid #eee;">{{ agent }}</td>
                    </tr>
                    <tr>
                        <td style="padding: 0.5rem; border-bottom: 1px solid #eee;"><strong>Exercise:</strong></td>
                        <td style="padding: 0.5rem; border-bottom: 1px solid #eee;">{{ exercise }}</td>
                    </tr>
                    <tr>
                        <td style="padding: 0.5rem; border-bottom: 1px solid #eee;"><strong>Model:</strong></td>
                        <td style="padding: 0.5rem; border-bottom: 1px solid #eee;">{{ model }}</td>
                    </tr>
                    <tr>
                        <td style="padding: 0.5rem; border-bottom: 1px solid #eee;"><strong>Language:</strong></td>
                        <td style="padding: 0.5rem; border-bottom: 1px solid #eee;">{{ language }}</td>
                    </tr>
                    {% if timestamp %}
                    <tr>
                        <td style="padding: 0.5rem; border-bottom: 1px solid #eee;"><strong>Timestamp:</strong></td>
                        <td style="padding: 0.5rem; border-bottom: 1px solid #eee;">{{ timestamp }}</td>
                    </tr>
                    {% endif %}
                    {% if duration %}
                    <tr>
                        <td style="padding: 0.5rem; border-bottom: 1px solid #eee;"><strong>Duration:</strong></td>
                        <td style="padding: 0.5rem; border-bottom: 1px solid #eee;">{{ duration }}</td>
                    </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>

        <!-- Trace File -->
        {% if has_trace %}
        <div>
            <h3 style="margin-bottom: 0.75rem;">Trace</h3>
            <a href="{{ trace_url }}" class="btn btn-primary">View Trace</a>
        </div>
        {% endif %}

        <!-- Actions -->
        <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid #eee;">
            <a href="/results" class="btn">Back to Results</a>
        </div>
    </div>
</div>
{% endblock %}
