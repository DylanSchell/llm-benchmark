{% extends "layout.tera" %}

{% block title %}Results - Claude Benchmark{% endblock %}

{% block content %}
<div class="container">
    <h2 style="margin-bottom: 1.5rem;">Results</h2>

    <!-- Statistics Summary -->
    <div class="card" style="margin-bottom: 1rem;">
        <h3 style="margin-bottom: 1rem;">Overall Statistics</h3>
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-value">{{ stats.total_runs }}</div>
                <div class="stat-label">Total Runs</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">{{ stats.total_exercises }}</div>
                <div class="stat-label">Exercises Run</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">{{ stats.successful_exercises }}</div>
                <div class="stat-label">Successful</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">{{ stats.success_rate_formatted }}%</div>
                <div class="stat-label">Success Rate</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">{{ stats.total_duration_formatted }}</div>
                <div class="stat-label">Total Time</div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card" style="margin-bottom: 1rem;">
        <form method="get" action="/results" style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-end;">
            <div class="form-group" style="margin-bottom: 0; min-width: 200px;">
                <label for="filter-language">Language</label>
                <select id="filter-language" name="language">
                    <option value="">All Languages</option>
                    <option value="java" {% if filter_language == "java" %}selected{% endif %}>Java</option>
                    <option value="go" {% if filter_language == "go" %}selected{% endif %}>Go</option>
                    <option value="javascript" {% if filter_language == "javascript" %}selected{% endif %}>JavaScript</option>
                    <option value="python" {% if filter_language == "python" %}selected{% endif %}>Python</option>
                    <option value="rust" {% if filter_language == "rust" %}selected{% endif %}>Rust</option>
                    <option value="cpp" {% if filter_language == "cpp" %}selected{% endif %}>C++</option>
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 0; min-width: 200px;">
                <label for="filter-agent">Agent</label>
                <select id="filter-agent" name="agent">
                    <option value="">All Agents</option>
                    <option value="reference" {% if filter_agent == "reference" %}selected{% endif %}>Reference</option>
                    <option value="claude" {% if filter_agent == "claude" %}selected{% endif %}>Claude</option>
                    <option value="pi" {% if filter_agent == "pi" %}selected{% endif %}>Pi</option>
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 0; min-width: 200px;">
                <label for="filter-model">Model</label>
                <select id="filter-model" name="model">
                    <option value="">All Models</option>
                    {% for m in models %}
                    <option value="{{ m }}" {% if filter_model == m %}selected{% endif %}>{{ m }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 0; min-width: 200px;">
                <label for="filter-exercise">Exercise</label>
                <select id="filter-exercise" name="exercise">
                    <option value="">All Exercises</option>
                    {% for e in exercises %}
                    <option value="{{ e }}" {% if filter_exercise == e %}selected{% endif %}>{{ e }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 0; display: flex; align-items: center;">
                <label style="display: flex; align-items: center; cursor: pointer; margin-top: 1.5rem;">
                    <input type="checkbox" name="quick" value="true"
                           {% if filter_quick %}checked{% endif %}
                           style="margin-right: 0.5rem; width: auto;">
                    <span>Quick bench only</span>
                </label>
            </div>

            <button type="submit" class="btn btn-primary">Filter</button>
            <a href="/results" class="btn">Clear</a>
        </form>
    </div>

    <!-- Language Statistics -->
    <div class="card" style="margin-bottom: 1rem;">
        <h3 style="margin-bottom: 1rem;">By Language</h3>
        <style>
            .stats-table { width: 100%; border-collapse: collapse; }
            .stats-table th { text-align: left; padding: 0.5rem; background: #f5f5f5; border-bottom: 2px solid #ddd; }
            .stats-table td { padding: 0.5rem; border-bottom: 1px solid #eee; }
        </style>
        <table class="stats-table">
            <thead>
                <tr>
                    <th>Language</th>
                    <th>Total Exercises</th>
                    <th>Successful</th>
                    <th>Success Rate</th>
                </tr>
            </thead>
            <tbody>
            {% for item in stats.language_stats %}
                {% set lang_total = item.total %}
                {% set lang_success = item.success %}
                <tr>
                    <td>
                        {% set href = "/results?language=" ~ item.name %}
                        {% if filter_agent != "" %}{% set href = href ~ "&agent=" ~ filter_agent %}{% endif %}
                        {% if filter_model != "" %}{% set href = href ~ "&model=" ~ filter_model %}{% endif %}
                        {% if filter_exercise != "" %}{% set href = href ~ "&exercise=" ~ filter_exercise %}{% endif %}
                        <a href="{{ href }}" style="color: #3498db; text-decoration: none;">{{ item.name }}</a>
                    </td>
                    <td>{{ lang_total }}</td>
                    <td>{{ lang_success }}</td>
                    <td>{{ item.success_rate_formatted }}%</td>
                </tr>
            {% endfor %}
            {% if stats.language_stats | length == 0 %}
                <tr>
                    <td colspan="4" style="text-align: center; color: #7f8c8d;">No language statistics available</td>
                </tr>
            {% endif %}
            </tbody>
        </table>
    </div>

    <!-- Individual Results -->
    <div class="card" {% if individual_results | length == 0 %}style="display: none;"{% endif %}>
        <h3 style="margin-bottom: 1rem;">Individual Exercise Results</h3>
        <p style="color: #7f8c8d; margin-bottom: 1rem;"
           {% if filter_language == "" and filter_agent == "" and filter_model == "" and filter_exercise == "" %}
           style="display: none;"
           {% endif %}>
            Showing exercises matching filters
        </p>
        <style>
            .timestamp-cell { white-space: nowrap; }
            .sortable-table th { cursor: pointer; user-select: none; }
            .sortable-table th:hover { background-color: #f0f0f0; }
        </style>
        <table class="sortable-table">
            <thead>
                <tr>
                    <th onclick="sortTable(this, false)" style="cursor: pointer;">Timestamp &#x2195;</th>
                    {% if filter_agent == "" %}
                    <th onclick="sortTable(this, false)" style="cursor: pointer;">Agent &#x2195;</th>
                    {% endif %}
                    {% if filter_model == "" %}
                    <th onclick="sortTable(this, false)" style="cursor: pointer;">Model &#x2195;</th>
                    {% endif %}
                    {% if filter_language == "" %}
                    <th onclick="sortTable(this, false)" style="cursor: pointer;">Language &#x2195;</th>
                    {% endif %}
                    {% if filter_exercise == "" %}
                    <th onclick="sortTable(this, false)" style="cursor: pointer;">Exercise &#x2195;</th>
                    {% endif %}
                    <th onclick="sortTable(this, true)" style="cursor: pointer;">Duration &#x2195;</th>
                    <th onclick="sortTable(this, false)" style="cursor: pointer;">Success &#x2195;</th>
                    <th onclick="sortTable(this, true)" style="cursor: pointer;">Tokens &#x2195;</th>
                    <th onclick="sortTable(this, false)" style="cursor: pointer;">Actions</th>
                </tr>
            </thead>
            <tbody id="individual-body">
            {% for indResult in individual_results %}
                <tr>
                    <td class="timestamp-cell" data-timestamp="{{ indResult.timestamp | default(value='') }}" data-timestamp-epoch="{{ indResult.timestamp_epoch | default(value=0) }}"><span class="local-time"></span></td>
                    {% if filter_agent == "" %}
                    <td>{{ indResult.agent }}</td>
                    {% endif %}
                    {% if filter_model == "" %}
                    <td>{{ indResult.model }}</td>
                    {% endif %}
                    {% if filter_language == "" %}
                    <td>{{ indResult.language }}</td>
                    {% endif %}
                    {% if filter_exercise == "" %}
                    <td><a href="{{ indResult.detail_url }}" style="text-decoration: underline; color: #3498db;">{{ indResult.exercise }}</a></td>
                    {% endif %}
                    <td data-sort="{{ indResult.sort_duration | default(value=0) }}">{{ indResult.duration | default(value="-") }}</td>
                    <td>
                        {% if indResult.success %}
                            &#x2713;
                        {% else %}
                            &#x2717;
                        {% endif %}
                    </td>
                    <td data-sort="{{ indResult.output_tokens | default(value=0) }}" title="Uncached / Cached / Output">
                        {{ indResult.uncached_input_tokens | default(value=0) | format_number }} /
                        {{ indResult.cached_input_tokens | default(value=0) | format_number }} /
                        {{ indResult.output_tokens | default(value=0) | format_number }}
                    </td>
                    <td>
                        {% if indResult.has_trace_file %}
                        <a href="{{ indResult.trace_url }}" class="btn btn-secondary" style="font-size: 0.8rem; padding: 0.2rem 0.5rem; white-space: nowrap;">View Trace</a>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="card" {% if individual_results | length > 0 %}style="display: none;"{% endif %}>
        <p style="text-align: center; color: #7f8c8d;">No individual results found. Try adjusting your filters.</p>
    </div>

    <script>
        // Convert UTC timestamps to local time on page load.
        // Each timestamp cell has data-timestamp (UTC ISO 8601) and data-timestamp-epoch.
        function convertTimestampsToLocal() {
            document.querySelectorAll('.timestamp-cell').forEach(cell => {
                const epoch = cell.getAttribute('data-timestamp-epoch');
                if (epoch && !isNaN(epoch)) {
                    const date = new Date(parseFloat(epoch) * 1000);
                    // Format as "YYYY-MM-DD HH:MM" in local timezone
                    const year = date.getFullYear();
                    const month = String(date.getMonth() + 1).padStart(2, '0');
                    const day = String(date.getDate()).padStart(2, '0');
                    const hours = String(date.getHours()).padStart(2, '0');
                    const minutes = String(date.getMinutes()).padStart(2, '0');
                    cell.textContent = `${year}-${month}-${day} ${hours}:${minutes}`;
                }
            });
        }

        // Run conversion as soon as DOM is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', convertTimestampsToLocal);
        } else {
            convertTimestampsToLocal();
        }

        // Table sorting function for results page
        let sortDirections = {};

        function sortTable(thEl, isNumeric) {
            // thEl is the clicked <th>; derive column index from its cellIndex
            const columnIdx = thEl.cellIndex;
            const table = thEl.closest('table');
            if (!table) return;

            const tbody = table.querySelector('tbody');
            if (!tbody) return;

            const rows = Array.from(tbody.querySelectorAll('tr'));
            if (rows.length === 0) return;

            const isTimestamp = thEl.textContent.trim().startsWith('Timestamp');
            const key = columnIdx;

            if (!sortDirections[key]) {
                sortDirections[key] = false;
            }
            sortDirections[key] = !sortDirections[key];
            const ascending = sortDirections[key];

            rows.sort((a, b) => {
                if (a.children.length === 0 || b.children.length === 0) return 0;

                let aVal, bVal;

                if (isTimestamp) {
                    // Use data-timestamp-epoch for reliable numeric sort
                    const aEpoch = parseFloat(a.children[columnIdx].getAttribute('data-timestamp-epoch') || '0');
                    const bEpoch = parseFloat(b.children[columnIdx].getAttribute('data-timestamp-epoch') || '0');
                    aVal = aEpoch;
                    bVal = bEpoch;
                } else if (isNumeric) {
                    let aSort = a.children[columnIdx].getAttribute('data-sort');
                    let bSort = b.children[columnIdx].getAttribute('data-sort');
                    if (aSort !== null && bSort !== null) {
                        aVal = parseFloat(aSort);
                        bVal = parseFloat(bSort);
                    } else {
                        aVal = parseFloat(a.children[columnIdx].textContent.trim().replace(/[^0-9.]/g, '')) || 0;
                        bVal = parseFloat(b.children[columnIdx].textContent.trim().replace(/[^0-9.]/g, '')) || 0;
                    }
                } else {
                    aVal = a.children[columnIdx].textContent.trim().toLowerCase();
                    bVal = b.children[columnIdx].textContent.trim().toLowerCase();
                }

                if (aVal < bVal) return ascending ? -1 : 1;
                if (aVal > bVal) return ascending ? 1 : -1;
                return 0;
            });

            rows.forEach(row => tbody.appendChild(row));
        }
    </script>
</div>
{% endblock %}
